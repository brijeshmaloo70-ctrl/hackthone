# Copy this file to .env and fill in your values.
# The key name MUST be GEMINI_API_KEY. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: models tried in order (comma-separated). -latest aliases survive model retirements.
# GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-flash-latest
# Optional: per-request timeout in seconds
# GEMINI_TIMEOUT=20

# Optional: contact info (used only by the mock WhatsApp/SMS gateway)
PATIENT_PHONE=+91-9876543210
CAREGIVER_PHONE=+91-8767377573
DOCTOR_PHONE=+91-9876543212

DB_PATH=data/patient_memory.db
DEMO_SPEED=fast
LOG_LEVEL=INFO
