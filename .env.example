GOOGLE_API_KEY=your_google_api_key_here

# Optional: Patient contact info for demo
PATIENT_PHONE=+91-9876543210
CAREGIVER_PHONE=+91-8767377573
DOCTOR_PHONE=+91-9876543212

# Database path (auto-created)
DB_PATH=data/patient_memory.db

# Demo settings
DEMO_SPEED=fast   # fast | normal | slow
LOG_LEVEL=INFO
